# MongoDB Atlas connection string
MONGO_URI=
# Pinata JWT (server only, never exposed to the browser)
PINATA_JWT=
# Your Pinata gateway address, no trailing slash
IPFS_GATEWAY=https://your-gateway-name.mypinata.cloud
# Optional. Comma-separated allowed frontend origins. Set before deploying publicly.
CORS_ORIGINS=http://localhost:3000
# Required. Secret used to sign sign-in tokens, at least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
