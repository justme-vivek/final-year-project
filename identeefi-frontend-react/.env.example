# Backend address. Use http://localhost:5000 locally, your Render address when deployed.
VITE_API_URL=http://localhost:5000
# Deployed Identeefi contract on Sepolia
VITE_CONTRACT_ADDRESS=0x62081f016446585cCC507528cc785980296b4Ccd
# Required. Project ID from dashboard.reown.com (add your site addresses as allowed domains)
VITE_WALLETCONNECT_PROJECT_ID=
